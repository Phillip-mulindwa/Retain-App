# Copy this file to .env and fill in real values before running the server.

# MongoDB Atlas (or local) connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/retain?retryWrites=true&w=majority

# Any long random string - used to sign JWTs
JWT_SECRET=change-this-to-something-long-and-random

# Port the API listens on
PORT=5000

# The frontend origin allowed to call this API (CORS)
CLIENT_URL=http://localhost:5173
